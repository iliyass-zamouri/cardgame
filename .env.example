# Copy to .env and fill in Google OAuth web + native client IDs.
HOST=127.0.0.1
PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cardgame
MYSQL_PASSWORD=cardgame
MYSQL_DATABASE=cardgame
MYSQL_ROOT_PASSWORD=root
# Comma-separated Google OAuth client IDs (Web + iOS + Android) accepted as aud
GOOGLE_CLIENT_IDS=
# Comma-separated Sign in with Apple audiences (iOS bundle id, e.g. com.hailsom.shadowhand)
APPLE_CLIENT_IDS=com.hailsom.shadowhand
# Sign in with Apple key (Apple Developer > Keys) for token revocation on
# account deletion. client_id is the first APPLE_CLIENT_IDS entry.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of AuthKey_<KEY_ID>.p8; newlines may be written as \n
APPLE_PRIVATE_KEY=
TRUST_PROXY=0
# Allow guest resume when device moves to a new IP (mobile roam)
GUEST_IP_REBIND=1
# Amount of cash reward for watching a rewarded video ad
AD_REWARD_MONEY=50
# Firebase Admin SDK service account (JSON path or inline JSON) for FCM
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional secret for POST /admin/push marketing blasts
ADMIN_PUSH_SECRET=
# HS256 secret for app session JWTs (required when NODE_ENV=production)
SESSION_SECRET=
# RevenueCat secret API key for server-side IAP verification
REVENUECAT_SECRET_API_KEY=
# Set to 1 in tests/dev to skip RevenueCat IAP verification
SKIP_IAP_VERIFY=0
# Minimum Android versionCode required to play (force update)
MIN_ANDROID_VERSION_CODE=1
SOFT_MIN_VERSION=
# Home menu layout (comma-separated, in display order; empty = all).
# Modes: createRoom,joinRoom,playVsRobot
# Nav: shop,friends,home,collection,rules (home is always kept)
HOME_MENU_MODES=
HOME_MENU_NAV=
# Voice chat (WebRTC). Self-hosted coturn on the game host: start it with
# COMPOSE_PROFILES=voice. Leave TURN_URLS empty for STUN-only (no relay).
# e.g. turn:<public-ip>:3478?transport=udp,turn:<public-ip>:3478?transport=tcp
TURN_URLS=
# Shared with coturn; generate with: openssl rand -hex 32
TURN_SHARED_SECRET=
TURN_REALM=cardgame
# OCI 1:1 NAT mapping for coturn: <public-ip>/<private-ip>
TURN_EXTERNAL_IP=
# Private VNIC IP coturn binds to (the right-hand side of TURN_EXTERNAL_IP)
TURN_PRIVATE_IP=
# Optional comma-separated STUN override (defaults to the TURN host)
STUN_URLS=
# COMPOSE_PROFILES=voice
