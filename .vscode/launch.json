{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: iOS Simulator (dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "542E34A4-ABA1-4A3B-B1B5-ED54D754F77E",
      "toolArgs": [
        "--dart-define-from-file=flavors/dev.json"
      ]
    },
    {
      "name": "Flutter: iOS Simulator (prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "542E34A4-ABA1-4A3B-B1B5-ED54D754F77E",
      "toolArgs": [
        "--dart-define-from-file=flavors/prod.json"
      ]
    },
    {
      "name": "Flutter: iOS Simulator (Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "deviceId": "542E34A4-ABA1-4A3B-B1B5-ED54D754F77E",
      "toolArgs": [
        "--dart-define-from-file=flavors/dev.json"
      ]
    },
    {
      "name": "Flutter: Chrome (dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--web-port=5173"
      ],
      "toolArgs": [
        "--dart-define-from-file=flavors/dev.json"
      ]
    },
    {
      "name": "Flutter: Chrome (prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--web-port=5173"
      ],
      "toolArgs": [
        "--dart-define-from-file=flavors/prod.json"
      ]
    },
    {
      "name": "Flutter: macOS (dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "macos",
      "toolArgs": [
        "--dart-define-from-file=flavors/dev.json"
      ]
    },
    {
      "name": "Flutter: macOS (prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "macos",
      "toolArgs": [
        "--dart-define-from-file=flavors/prod.json"
      ]
    },
    {
      "name": "Flutter: Android Emulator (dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "emulator-5554",
      "toolArgs": [
        "--dart-define-from-file=flavors/android_emulator.json"
      ]
    },
    {
      "name": "Flutter: Android Device (prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=flavors/prod.json"
      ]
    },
    {
      "name": "Game Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:docker"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": false
    },
    {
      "name": "Game Server (local node)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "8080",
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "cardgame",
        "MYSQL_PASSWORD": "cardgame",
        "MYSQL_DATABASE": "cardgame",
        "GUEST_IP_REBIND": "1"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: iOS + Server",
      "configurations": [
        "Game Server",
        "Flutter: iOS Simulator (dev)"
      ],
      "stopAll": true,
      "presentation": {
        "order": 1,
        "group": "fullstack",
        "hidden": false
      }
    },
    {
      "name": "Full Stack: Chrome + Server",
      "configurations": [
        "Game Server",
        "Flutter: Chrome (dev)"
      ],
      "stopAll": true,
      "presentation": {
        "order": 2,
        "group": "fullstack",
        "hidden": false
      }
    },
    {
      "name": "Full Stack: macOS + Server",
      "configurations": [
        "Game Server",
        "Flutter: macOS (dev)"
      ],
      "stopAll": true,
      "presentation": {
        "order": 3,
        "group": "fullstack",
        "hidden": false
      }
    }
  ]
}
