{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: iOS Simulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "542E34A4-ABA1-4A3B-B1B5-ED54D754F77E",
      "toolArgs": [
        "--dart-define=WS_HOST=127.0.0.1",
        "--dart-define=WS_PORT=8080",
        "--dart-define=HTTP_URL=http://127.0.0.1:8080",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=336790716391-cfhpcah0v00avevev4nihlphvpt14mc8.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Flutter: iOS Simulator (Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "deviceId": "542E34A4-ABA1-4A3B-B1B5-ED54D754F77E"
    },
    {
      "name": "Flutter: Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--web-port=5173"
      ],
      "toolArgs": [
        "--dart-define=WS_HOST=127.0.0.1",
        "--dart-define=WS_PORT=8080",
        "--dart-define=HTTP_URL=http://127.0.0.1:8080",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=336790716391-cfhpcah0v00avevev4nihlphvpt14mc8.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Flutter: macOS",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "macos",
      "toolArgs": [
        "--dart-define=WS_HOST=127.0.0.1",
        "--dart-define=WS_PORT=8080",
        "--dart-define=HTTP_URL=http://127.0.0.1:8080",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=336790716391-cfhpcah0v00avevev4nihlphvpt14mc8.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Flutter: Android Emulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "emulator-5554",
      "toolArgs": [
        "--dart-define=WS_HOST=10.0.2.2",
        "--dart-define=WS_PORT=8080",
        "--dart-define=HTTP_URL=http://10.0.2.2:8080",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=336790716391-cfhpcah0v00avevev4nihlphvpt14mc8.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Game Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:docker"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": false
    },
    {
      "name": "Game Server (local node)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "8080",
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "cardgame",
        "MYSQL_PASSWORD": "cardgame",
        "MYSQL_DATABASE": "cardgame",
        "GUEST_IP_REBIND": "1"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: iOS + Server",
      "configurations": [
        "Game Server",
        "Flutter: iOS Simulator"
      ],
      "stopAll": true,
      "presentation": {
        "order": 1,
        "group": "fullstack",
        "hidden": false
      }
    },
    {
      "name": "Full Stack: Chrome + Server",
      "configurations": [
        "Game Server",
        "Flutter: Chrome"
      ],
      "stopAll": true,
      "presentation": {
